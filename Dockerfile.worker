# syntax=docker/dockerfile:1
FROM node:22-alpine AS base

WORKDIR /app

# Install dependencies needed for native modules
RUN apk add --no-cache libc6-compat

# Install package dependencies
COPY package.json package-lock.json ./
RUN npm ci --omit=dev

# Copy application source code
COPY tsconfig.json ./
COPY src ./src
COPY contracts ./contracts

# Set production environment
ENV NODE_ENV=production
ENV WORKER_HEALTH_PORT=9090

# Non-root user for security hardening
USER node

# Expose health and metrics probe port
EXPOSE 9090

# Health check probe against embedded worker endpoint
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://127.0.0.1:9090/healthz || exit 1

# Launch the supervised outbox worker runtime
CMD ["node", "--experimental-strip-types", "src/workers/outbox-worker.ts"]
